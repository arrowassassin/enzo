# Rust build output (host workspace and device workspace)
/firmware/target/
/firmware/device/target/
**/*.rs.bk

# Built firmware images and release bundles (CI attaches them to releases)
/dist/
/firmware/dist/
*.bin
!/firmware/device/**/*.bin.keep
# Data that is source, not build output
!/firmware/device/crates/quire-net/roots/roots.bin
!/firmware/device/crates/quire-net/testdata/*.bin
!/bookshop/catalog.bin

# Generated review artefacts
/firmware/target/snapshots/
/firmware/tools/sleepgen/out/

# Editors and OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Local secrets (Wi-Fi credentials for the simulator, signing keys)
/firmware/.env
/firmware/keys/
*.pem
*.key
!**/fixtures/**/*.key
